<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and the sign-in session stay on the device; signing in restores progress from the account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lectio_secure.xml" />
    </device-transfer>
</data-extraction-rules>
