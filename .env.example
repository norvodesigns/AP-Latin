# ---------------------------------------------------------------------------
# AP Latin — environment variables
#
# Copy this file to .env.local for local development:
#     cp .env.example .env.local
#
# NEVER prefix any of these with NEXT_PUBLIC_. These keys are read only inside
# Route Handlers under src/app/api/ and must never reach the browser bundle.
# ---------------------------------------------------------------------------

# Primary provider: Google Gemini (free tier).
# Get a key at https://aistudio.google.com/apikey  — see README.md.
GOOGLE_GENERATIVE_AI_API_KEY=

# Fallback provider: Groq. Optional but recommended.
# The app automatically falls back to Groq on 429 (rate limit) or
# model-not-found errors from Gemini. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional model overrides. Sensible defaults are used when unset — see the
# comment in src/lib/ai/provider.ts for what they currently are and why they
# are worth checking before assuming this file is current: free-tier model
# names get retired without much notice.
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Supabase — accounts, classrooms and leaderboards (optional)
#
# Leave these blank and Lectio runs in SOLO MODE: no login, no classrooms, no
# leaderboards, progress stored in the browser. Every study feature still works.
#
# Set them and CLASSROOM MODE turns on: student and teacher accounts, join
# codes, assignments, and per-classroom leaderboards.
#
# To get them: create a project at https://supabase.com/dashboard, then
# Project Settings -> API. Run supabase/migrations/*.sql in the SQL Editor
# (in filename order) before signing anyone up.
#
# These two ARE safe to expose to the browser — the anon key is designed to be
# public, and row-level security in the database is what protects student data.
# Never put the service_role key in this file or anywhere with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
